# RPC URL для тестовой сети Sepolia (например, от Alchemy или Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key

# Приватный ключ кошелька для деплоя в Sepolia (БЕЗ префикса 0x, тестовый кошелек!)
PRIVATE_KEY=your_private_key_here

# API ключ Etherscan для автоматической верификации контрактов
ETHERSCAN_API_KEY=your_etherscan_api_key

# Включение отчета о расходе газа при тестах (true / false)
REPORT_GAS=true
