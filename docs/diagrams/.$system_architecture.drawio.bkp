<mxfile host="Electron">
  <diagram id="system-architecture" name="Архітектура системи">
    <mxGraphModel dx="1704" dy="1013" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="750" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontFamily=Helvetica;" value="&lt;b&gt;АРХІТЕКТУРА ДЕЦЕНТРАЛІЗОВАНОЇ СИСТЕМИ КРАУДФАНДИНГУ (dApp)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;Рольова модель • Взаємодія трьох смарт-контрактів через інтерфейси • Безпека CEI та Pull over Push&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="800" x="250" y="15" as="geometry" />
        </mxCell>
        <mxCell id="box_roles" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;fontColor=#0f172a;strokeColor=#94a3b8;strokeWidth=2;fontStyle=1;fontSize=12;fontFamily=Helvetica;startSize=32;rounded=1;arcSize=6;" value="АКТОРИ ТА РОЛЬОВА МОДЕЛЬ" vertex="1">
          <mxGeometry height="580" width="250" x="40" y="90" as="geometry" />
        </mxCell>
        <mxCell id="role_admin" parent="box_roles" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#9333ea;strokeWidth=1.5;fontColor=#581c87;fontFamily=Helvetica;align=center;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Admin&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;(Власник / Deployer)&lt;/font&gt;&lt;hr style=&quot;border-color: #9333ea;&quot;&gt;&lt;div style=&quot;text-align: left; font-size: 11px;&quot;&gt;• Верифікація авторів&lt;br&gt;• Аварійна зупинка (pause)&lt;br&gt;• Відновлення роботи (unpause)&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="220" x="15" y="45" as="geometry" />
        </mxCell>
        <mxCell id="role_author" parent="box_roles" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#14532d;fontFamily=Helvetica;align=center;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Author&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;(Верифікований автор)&lt;/font&gt;&lt;hr style=&quot;border-color: #16a34a;&quot;&gt;&lt;div style=&quot;text-align: left; font-size: 11px;&quot;&gt;• Створення кампаній&lt;br&gt;• Встановлення цілі та дедлайну&lt;br&gt;• Виведення коштів (claim)&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="220" x="15" y="225" as="geometry" />
        </mxCell>
        <mxCell id="role_contributor" parent="box_roles" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#0c4a6e;fontFamily=Helvetica;align=center;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Contributor&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;(Вкладник / Інвестор)&lt;/font&gt;&lt;hr style=&quot;border-color: #0284c7;&quot;&gt;&lt;div style=&quot;text-align: left; font-size: 11px;&quot;&gt;• Внесення ETH (pledge)&lt;br&gt;• Отримання RewardToken (CRT)&lt;br&gt;• Повернення внеску (Pull refund)&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="220" x="15" y="405" as="geometry" />
        </mxCell>
        <mxCell id="c_crowdfunding" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=2;fontColor=#0c4a6e;fontFamily=Helvetica;align=center;verticalAlign=top;" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;Crowdfunding.sol (ГОЛОВНИЙ КОНТРАКТ)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;&amp;lt;&amp;lt;ICrowdfunding, Ownable, Pausable&amp;gt;&amp;gt;&lt;/font&gt;&lt;hr style=&quot;border-color: #0284c7;&quot;&gt;&lt;div style=&quot;text-align: left; font-size: 11px;&quot;&gt;&lt;b&gt;Сховище стану (Storage):&lt;/b&gt;&lt;br&gt;+ campaigns: mapping(uint256 =&gt; Campaign)&lt;br&gt;+ contributions: mapping(uint256 =&gt; mapping(address =&gt; uint256))&lt;br&gt;+ authorRegistry: IAuthorRegistry&lt;br&gt;+ rewardToken: IRewardToken&lt;br&gt;+ campaignCount: uint256&lt;br&gt;&lt;br&gt;&lt;b&gt;Методи життєвого циклу (OpenZeppelin + CEI):&lt;/b&gt;&lt;br&gt;+ createCampaign(goal, duration): uint256&lt;br&gt;+ pledge(campaignId) [payable, whenNotPaused]&lt;br&gt;+ claim(campaignId) [whenNotPaused, CEI]&lt;br&gt;+ claimRefund(campaignId) [whenNotPaused, Pull over Push, CEI]&lt;br&gt;+ getCampaigns(offset, limit): (Campaign[], total)&lt;br&gt;+ pause() / unpause() [onlyOwner]&lt;/div&gt;" vertex="1">
          <mxGeometry height="460" width="460" x="360" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c_author_reg" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#9333ea;strokeWidth=1.5;fontColor=#581c87;fontFamily=Helvetica;align=center;verticalAlign=top;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;AuthorRegistry.sol&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;&amp;lt;&amp;lt;IAuthorRegistry, Ownable&amp;gt;&amp;gt;&lt;/font&gt;&lt;hr style=&quot;border-color: #9333ea;&quot;&gt;&lt;div style=&quot;text-align: left; font-size: 11px;&quot;&gt;&lt;b&gt;Сховище стану:&lt;/b&gt;&lt;br&gt;+ isAuthor: mapping(address =&gt; bool)&lt;br&gt;&lt;br&gt;&lt;b&gt;Методи реєстру:&lt;/b&gt;&lt;br&gt;+ addAuthor(address) [onlyOwner]&lt;br&gt;+ batchAddAuthors(address[]) [onlyOwner]&lt;br&gt;+ removeAuthor(address) [onlyOwner]&lt;br&gt;+ isVerified(address): bool&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="350" x="890" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c_reward_tok" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;fontColor=#78350f;fontFamily=Helvetica;align=center;verticalAlign=top;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;RewardToken.sol&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;&amp;lt;&amp;lt;IRewardToken, ERC20, Ownable&amp;gt;&amp;gt;&lt;/font&gt;&lt;hr style=&quot;border-color: #d97706;&quot;&gt;&lt;div style=&quot;text-align: left; font-size: 11px;&quot;&gt;&lt;b&gt;Параметри токена (CRT):&lt;/b&gt;&lt;br&gt;• Назва: Crowd Reward Token (CRT)&lt;br&gt;• Власник: Crowdfunding (onlyOwner)&lt;br&gt;&lt;br&gt;&lt;b&gt;Методи токена:&lt;/b&gt;&lt;br&gt;+ mint(address to, uint256 amount) [onlyOwner]&lt;br&gt;+ balanceOf(address): uint256&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="350" x="1100" y="295" as="geometry" />
        </mxCell>
        <mxCell id="edge_admin_add_author" edge="1" parent="1" source="role_admin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeColor=#9333ea;strokeWidth=2;fontColor=#581c87;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="c_author_reg" value="&lt;b&gt;addAuthor()&lt;/b&gt;">
          <mxGeometry relative="1" x="-0.1" y="-10" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="165" y="130" />
              <mxPoint x="1065" y="130" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_admin_pause" edge="1" parent="1" source="role_admin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeColor=#9333ea;strokeWidth=1.5;strokeDasharray=4 4;fontColor=#581c87;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" target="c_crowdfunding" value="&lt;b&gt;pause() / unpause()&lt;/b&gt;">
          <mxGeometry relative="1" x="0.1" y="-10" as="geometry" />
        </mxCell>
        <mxCell id="edge_author_actions" edge="1" parent="1" source="role_author" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeColor=#16a34a;strokeWidth=2;fontColor=#14532d;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="c_crowdfunding" value="&lt;b&gt;createCampaign()&lt;/b&gt;&lt;br&gt;&lt;b&gt;claim()&lt;/b&gt; [при успіху]">
          <mxGeometry relative="1" x="0.1" y="-12" as="geometry" />
        </mxCell>
        <mxCell id="edge_contrib_actions" edge="1" parent="1" source="role_contributor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeColor=#0284c7;strokeWidth=2;fontColor=#0c4a6e;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" target="c_crowdfunding" value="&lt;b&gt;pledge()&lt;/b&gt; {value: ETH}&lt;br&gt;&lt;b&gt;claimRefund()&lt;/b&gt; [Pull refund]">
          <mxGeometry relative="1" x="0.1" y="12" as="geometry" />
        </mxCell>
        <mxCell id="edge_cf_verify" edge="1" parent="1" source="c_crowdfunding" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeColor=#9333ea;strokeWidth=2;fontColor=#581c87;fontFamily=Helvetica;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="c_author_reg" value="&lt;b&gt;authorRegistry.isVerified(author)&lt;/b&gt;">
          <mxGeometry relative="1" x="0.1" y="-10" as="geometry" />
        </mxCell>
        <mxCell id="edge_cf_mint" edge="1" parent="1" source="c_crowdfunding" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeColor=#d97706;strokeWidth=2;fontColor=#78350f;fontFamily=Helvetica;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="c_reward_tok" value="&lt;b&gt;rewardToken.mint(contributor, msg.value)&lt;/b&gt;&lt;br&gt;[Співвідношення 1 ETH = 1 CRT]">
          <mxGeometry relative="1" x="0.1" y="10" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
